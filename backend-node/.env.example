# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.gcjphyp.mongodb.net/sobd?appName=Cluster0

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGIN=https://sobd-web.vercel.app

# Server port (Vercel ignores this; only used for local dev)
PORT=5000
